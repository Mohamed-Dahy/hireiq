# Copy this file to .env and fill in your values
# Get a free Groq key at: https://console.groq.com

GROQ_API_KEY=gsk_your_key_here

# Embeddings run locally — no key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL credentials (used by Docker Compose to create the database)
POSTGRES_USER=hireiq
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=hireiq

# PostgreSQL connection URL (for local dev; Docker overrides this via .env.docker)
DATABASE_URL=postgresql://hireiq:change-me-to-a-strong-password@localhost:5432/hireiq

# Redis (Docker default)
REDIS_URL=redis://localhost:6379

# JWT — change this to any long random string (32+ chars)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Where uploaded CVs are saved on disk
UPLOAD_DIR=./uploads

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ChromaDB (use localhost:8001 for local dev via docker-compose)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Email via Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here              # Resend API key for sending OTP emails
FROM_EMAIL=noreply@yourdomain.com            # Sender address (must be verified in Resend)

# Admin user seeded on first run (change before production!)
ADMIN_EMAIL=admin@yourdomain.com             # Email for the bootstrap admin account
ADMIN_PASSWORD=change-me-before-deploying    # Password for the bootstrap admin account

# AI Token / Quota Management
FREE_TIER_ANALYSIS_LIMIT=2                   # Max CV analyses for free-tier users per rolling window
FREE_TIER_WINDOW_DAYS=10                     # Rolling window in days for free-tier limit
PAID_TIER_DAILY_TOKEN_LIMIT=10000            # Daily LLM token budget for paid-tier users
LLM_PROVIDER=groq                            # Active LLM provider (groq, openai, etc.)
LLM_MODEL=llama-3.3-70b-versatile           # Default LLM model name
GROQ_PRICE_PER_1K_TOKENS=0.0006             # Groq cost per 1K tokens (for cost estimation)

# OTP Security
OTP_HMAC_SECRET=change-this-to-a-random-secret   # HMAC key for hashing OTP codes (32+ chars)
OTP_EXPIRY_MINUTES=10                             # OTP code validity duration in minutes
OTP_MAX_ATTEMPTS=5                                # Max failed OTP attempts before lockout
OTP_RATE_LIMIT_PER_30MIN=3                        # Max OTP send requests per 30 min per email

# ATS Score Checker (non-secret scoring thresholds)
ATS_MIN_WORDS=300                                 # CVs with fewer words are flagged as too thin
ATS_MAX_PAGES=2                                   # CVs longer than this are flagged as too long
ATS_MIN_ACTION_VERBS=5                            # Minimum distinct action verbs expected
ATS_MIN_PARSE_CHARS_PER_PAGE=250                  # Below this avg chars/page ⇒ likely image-only/scanned
