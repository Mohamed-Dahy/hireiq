# Copy this file to .env and fill in your values
# Get a free Groq key at: https://console.groq.com

GROQ_API_KEY=gsk_your_key_here

# Embeddings run locally — no key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL (Docker default)
DATABASE_URL=postgresql://postgres:password@localhost:5432/hireiq

# Redis (Docker default)
REDIS_URL=redis://localhost:6379

# JWT — change this to any long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Where uploaded CVs are saved on disk
UPLOAD_DIR=./uploads
