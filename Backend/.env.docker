# Docker-specific service URLs — overrides .env when running via docker-compose.
# Secrets (GROQ_API_KEY, JWT_SECRET) are still loaded from .env.
DATABASE_URL=postgresql://postgres:1192004@host.docker.internal:5432/hireiq
REDIS_URL=redis://redis:6379
ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads
